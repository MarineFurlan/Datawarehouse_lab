for entry in \
  ".venv/" \
  "target/" \
  "logs/" \
  "dbt_packages/" \
  "__pycache__/" \
  "*.pyc" \
  ".env" \
  ".env.*" \
  "*.pem" \
  "*.key" \
  "*credentials*.json" \
  "*service-account*.json"
do
  grep -qxF "$entry" .gitignore || printf '%s\n' "$entry" >> .gitignore
done

sed -n '1,120p' .gitignore